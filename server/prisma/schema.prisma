// Generated by prisma init — DO NOT EDIT datasource manually
// To switch to PostgreSQL in production, change DATABASE_URL in .env to:
// DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  name         String
  avatarUrl    String?            @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=256")
  role         String             @default("user")
  persona      String?
  language     String             @default("en")
  currency     String             @default("INR")
  isSuspended  Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  trips        Trip[]
  savedCities  SavedDestination[]
}

model City {
  id          String             @id
  name        String
  country     String
  iata        String
  lat         Float
  lng         Float
  image       String
  description String
  costIndex   Int                @default(3)
  popularity  Int                @default(5)
  region      String
  bestSeason  String
  activities  Activity[]
  stops       Stop[]
  savedBy     SavedDestination[]
}

model Activity {
  id             String         @id
  cityId         String
  city           City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name           String
  type           String
  cost           Float
  durationMin    Int
  rating         Float
  description    String
  image          String
  stopActivities StopActivity[]
}

model Trip {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   String
  endDate     String
  coverUrl    String
  isPublic    Boolean       @default(false)
  shareSlug   String        @unique
  budgetCap   Float         @default(200000)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  stops       Stop[]
  expenses    Expense[]
}

model Stop {
  id             String         @id @default(uuid())
  tripId         String
  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId         String
  city           City           @relation(fields: [cityId], references: [id])
  startDate      String
  endDate        String
  orderIndex     Int            @default(0)
  stopActivities StopActivity[]
}

model StopActivity {
  id           String   @id @default(uuid())
  stopId       String
  stop         Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id])
  dayDate      String
  startTime    String
  notes        String?
  costOverride Float?
  orderIndex   Int      @default(0)
}

model Expense {
  id       String @id @default(uuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category String
  amount   Float
  currency String @default("INR")
  notes    String?
  date     String
}

model SavedDestination {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cityId])
}
